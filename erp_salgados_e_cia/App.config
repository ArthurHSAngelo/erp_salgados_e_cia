<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <connectionStrings>
        <!-- Banco local. Troque a senha pela que voce definiu para o usuario app_salgados (ver database/README.md). -->
        <add name="salgados_cia" connectionString="Server=localhost;Port=3306;Database=salgados_cia;Uid=app_salgados;Pwd=TROQUE_ESTA_SENHA_FORTE;CharSet=utf8mb4;" />
    </connectionStrings>
</configuration>